{
  "name": "mycelium-v2",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run build:shared && bun run build:server && bun run build:cli && bun run build:mcp && bun run build:client",
    "build:shared": "cd packages/shared && bun run build",
    "build:server": "cd packages/server && bun run build",
    "build:cli": "cd packages/cli && bun run build",
    "build:mcp": "cd packages/mcp && bun run build",
    "build:client": "cd packages/client && bun run build",
    "dev": "bun run dev:server",
    "dev:server": "cd packages/server && bun run dev",
    "dev:client": "cd packages/client && bun run dev",
    "typecheck": "bun run typecheck:shared && bun run typecheck:server",
    "typecheck:shared": "cd packages/shared && tsc --noEmit",
    "typecheck:server": "cd packages/server && tsc --noEmit",
    "clean": "rm -rf packages/*/dist",
    "dev:manage": "bun scripts/dev.ts",
    "test": "bun test",
    "db:generate": "bun run --filter server db:generate",
    "db:migrate": "bun run --filter server db:migrate",
    "db:studio": "bun run --filter server db:studio"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "typescript": "^6.0.3"
  }
}
