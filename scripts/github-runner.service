[Unit]
Description=GitHub Actions Self-Hosted Runner
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/github-runner
ExecStart=%h/.local/share/github-runner/run.sh
Restart=always
RestartSec=10
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

[Install]
WantedBy=default.target
