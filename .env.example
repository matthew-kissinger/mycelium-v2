# Mycelium v2 Environment Configuration
# Copy to .env.local and fill in your values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Server Configuration (optional)
PORT=8765
HOST=0.0.0.0

# Database (optional - defaults to ~/.config/mycelium-v2/mycelium.db)
# DATABASE_PATH=/path/to/mycelium.db

# Logging (optional)
# LOG_LEVEL=info

# GitHub Webhook (optional - without this, all webhook requests are accepted)
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GitHub Copilot Token (optional - needed for copilot agent)
# COPILOT_TOKEN=your-gh-token

# Note: GitHub CLI must be authenticated via `gh auth login` for GitHub integration

# MCP API URL for CLI (optional)
MYCEL_API_URL=http://localhost:8765
